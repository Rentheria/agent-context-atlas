# OpenAI-compatible embeddings endpoint (local or cloud).
# No secrets belong in this repo — copy to .env and fill locally.
ATLAS_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
ATLAS_EMBEDDINGS_MODEL=text-embedding-3-small
ATLAS_EMBEDDINGS_API_KEY=

# Bench only (npm run bench). mock = no HTTP. http = use the embeddings vars above.
# ATLAS_BENCH_MODE=mock
# ATLAS_BENCH_OUT=bench-results.json
